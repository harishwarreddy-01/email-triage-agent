              "value": "={{ (o => (o.category === 'invoice' && o.due_date) ? Object.assign(o, { priority: (DateTime.fromISO(o.due_date).diff($now.startOf('day'), 'days').days <= 7 ? 'high' : 'medium') }) : o)(JSON.parse($json.output)) }}",
              "type": "object"
